{
  "name": "masys-video-generator",
  "version": "1.0.2",
  "private": true,
  "description": "Tool cục bộ điều phối Meta Muse tạo video từ Google Sheet (spec v4.1)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:google": "vitest run -c vitest.live.config.ts",
    "tien-do": "node scripts/tien-do.mjs",
    "check-secrets": "node scripts/check-secrets.mjs",
    "package": "node scripts/package.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "google-auth-library": "^11.3.1",
    "hono": "^4.13.14",
    "pino": "^10.4.0",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.4",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
