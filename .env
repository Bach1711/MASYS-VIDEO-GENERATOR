# File này CHỈ chứa địa chỉ op:// và cấu hình không bí mật → được phép commit.
# Tạo .env.local (đã giải mã, bị .gitignore) bằng:
#   op inject -i .env -o .env.local
# hoặc chạy trực tiếp không ghi ra đĩa:
#   op run --env-file=.env -- npm run dev
#
# Vault: MASYS-VIDEO-GENERATOR · Spec v2.1

# ── Provider chính: Max-Studio (spec §8.1) ───────────────────
# Tên miền lấy từ mã nguồn trang /docs (23/10/2026): API tạo task ở .online, tài khoản ở .shop
MAX_STUDIO_BASE_URL="https://max-studio.online"
# Web backend (số dư, trạng thái key) — khác tên miền với API tạo task
MAX_STUDIO_WEB_URL="https://max-studio.shop"
MAX_STUDIO_API_KEY="op://MASYS-VIDEO-GENERATOR/Max-Studio API Key/credential"
# Token Flow (JWT) của TÀI KHOẢN FLOW — bí mật nhạy cảm nhất (spec §10):
# chỉ gửi tới Max-Studio, không bao giờ log.
FLOW_TOKEN="op://MASYS-VIDEO-GENERATOR/Flow Token/credential"

# ── Provider dự phòng: Gemini Omni Flash (D12, mặc định TẮT, tính tiền) ──
GEMINI_API_KEY="op://MASYS-VIDEO-GENERATOR/Gemini API/credential"

# ── Google OAuth Desktop — đăng nhập bằng TÀI KHOẢN DỮ LIỆU, không phải tài khoản Flow (D7, §8.3)
GOOGLE_OAUTH_CLIENT_ID="op://MASYS-VIDEO-GENERATOR/Google OAuth Desktop/client_id"
GOOGLE_OAUTH_CLIENT_SECRET="op://MASYS-VIDEO-GENERATOR/Google OAuth Desktop/client_secret"

# ── GitHub token để electron-builder publish lên GitHub Releases (F9)
GH_TOKEN="op://MASYS-VIDEO-GENERATOR/GitHub Release Token/credential"

# ── Max-Studio V3: cookie Google Labs của TÀI KHOẢN FLOW (thay cho FLOW_TOKEN) — nhạy cảm nhất, không bao giờ log
FLOW_COOKIE="op://MASYS-VIDEO-GENERATOR/Flow Cookie/credential"
