# File này CHỈ chứa địa chỉ op://, không chứa key thật → được phép commit.
# Tạo .env.local (đã giải mã, bị .gitignore) bằng:
#   op inject -i .env -o .env.local
# hoặc chạy trực tiếp không ghi ra đĩa:
#   op run --env-file=.env -- npm run dev
#
# Vault: MASYS-VIDEO-GENERATOR

# Gemini API (Omni Flash) — key của project đã bật billing (spec §8.1)
GEMINI_API_KEY="op://MASYS-VIDEO-GENERATOR/Gemini API/credential"

# Google OAuth client loại Desktop app (spec §8.2)
GOOGLE_OAUTH_CLIENT_ID="op://MASYS-VIDEO-GENERATOR/Google OAuth Desktop/client_id"
GOOGLE_OAUTH_CLIENT_SECRET="op://MASYS-VIDEO-GENERATOR/Google OAuth Desktop/client_secret"

# GitHub token để electron-builder publish lên GitHub Releases (spec F9, §15.8)
GH_TOKEN="op://MASYS-VIDEO-GENERATOR/GitHub Release Token/credential"
